{
  "name": "bale-delivery-tracker",
  "version": "1.0.0",
  "description": "Delivery and bale tracking system",
  "main": "backend/server.js",
  "scripts": {
    "server": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
